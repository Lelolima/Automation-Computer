# ============================================
# Agente Autônomo de Automação Integrada
# Configurações de Ambiente - Elite Version
# ============================================
# Copie este arquivo para .env e preencha os valores
# ============================================

# --------------------------------------------
# Configurações Básicas
# --------------------------------------------
DEBUG=false
ENVIRONMENT=development

# Chaves secretas (GERE VALORES SEGUROS PARA PRODUÇÃO!)
# Para gerar uma chave segura: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=sua-secret-key-aqui-gerar-em-producao
ENCRYPTION_KEY=sua-encryption-key-aqui-32-bytes-minimo

# --------------------------------------------
# Configurações de Log
# --------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=logs/automation.log

# --------------------------------------------
# Configurações de Banco de Dados
# --------------------------------------------
# PostgreSQL (recomendado para produção)
DATABASE_URL=postgresql://user:password@localhost:5432/automation_db

# SQLite (desenvolvimento)
# DATABASE_URL=sqlite:///./sqlite.db

TEST_DATABASE_URL=sqlite:///./test_sqlite.db

# Redis (cache e filas)
REDIS_URL=redis://localhost:6379/0

# --------------------------------------------
# Configurações de LLM (Opcional)
# --------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

LLM_PROVIDER=openai
LLM_MODEL=gpt-4
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000

# --------------------------------------------
# Configurações de Navegador
# --------------------------------------------
BROWSER=chrome
HEADLESS=false
WINDOW_WIDTH=1280
WINDOW_HEIGHT=800

# --------------------------------------------
# Configurações de Segurança Avançada
# --------------------------------------------
MAX_CONCURRENT_TASKS=5
BLOCK_DANGEROUS_COMMANDS=true
REQUIRE_AUTHENTICATION=true

# --------------------------------------------
# Configurações de Voz
# --------------------------------------------
VOICE_LANGUAGE=pt-BR
VOICE_RATE=150

# --------------------------------------------
# Tokens JWT
# --------------------------------------------
SECURITY_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# --------------------------------------------
# Proxy (se necessário)
# --------------------------------------------
HTTP_PROXY=
HTTPS_PROXY=
