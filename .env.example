# Chaves de API
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
OLLAMA_HOST=http://localhost:11434

# Configurações de Automação
DEFAULT_DELAY=0.5
MAX_RETRIES=3
SCREENSHOT_DIR=./screenshots

# Segurança
ENCRYPTION_KEY=gerada-automaticamente-na-primeira-execucao
SANDBOX_ENABLED=true
AUDIT_ENABLED=true

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=10

# Voice
VOICE_ENABLED=false
SPEECH_RECOGNITION_ENGINE=whisper