# Copie para .env (carregado automaticamente pela CLI via python-dotenv).
# Nunca versione o .env com chaves reais.

# Provedores de LLM (só necessários se usar o LLMOrchestrator)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Lido pela biblioteca `ollama` (servidor local)
OLLAMA_HOST=http://localhost:11434

# Modelos (opcionais; padrões em src/ai/llm_orchestrator.py)
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# OPENAI_MODEL=gpt-4o
# OLLAMA_MODEL=llama3.2
